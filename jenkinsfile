pipeline {
agent any   
environment {
    AWS_DEFAULT_REGION = 'us-east-1'
PATH = "/var/lib/jenkins/.local/bin:${env.PATH}"
} 

stages {
    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('AWS Authentication') {
        steps {
            sh 'aws sts get-caller-identity'
        }
    }

    stage('Terraform Init') {
        steps {
            dir ('terraform') {
                sh 'terraform init'
            }
        }
    }

    stage('Terraform validate') {
        steps {
            dir ('terraform') {
                sh 'terraform validate'
            }
        }
    }

    stage('Checkov Security Scan') {
        steps {
            dir('terraform'){

                sh 'checkov --version'
                sh 'checkov --directory . --framework terraform'
            }
        }
    }

    stage('Terraform plan') {
        steps {
            dir ('terraform') {
                sh 'terraform plan'
            }
        }
    }

}
}