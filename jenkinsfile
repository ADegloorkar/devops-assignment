pipeline {
agent any   
environment {
    AWS_DEFAULT_REGION = 'us-east-1'

} 

stages {
    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('AWS Authentication') {
        steps {
            sh 'aws sts get-caller-identity'
        }
    }

    stage('Terraform Init') {
        steps {
            dir ('terraform') {
                sh 'terraform init'
            }
        }
    }

    stage('Terraform validate') {
        steps {
            dir ('terraform') {
                sh 'terraform validate'
            }
        }
    }

    stage('Terraform plan') {
        steps {
            dir ('terraform') {
                sh 'terraform plan'
            }
        }
    }

}
}